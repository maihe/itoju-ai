# Chave de API do OpenRouter (https://openrouter.ai/keys).
# Nunca commitar um valor real — usada só no servidor (ver ADR-006).
OPENROUTER_API_KEY=

# Configuração do modelo — trocar de modelo (inclusive de fornecedor)
# é mudar estas variáveis, nunca o código (ver ModelConfiguration.ts).
AI_PROVIDER=openrouter
AI_MODEL=anthropic/claude-sonnet-5
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=400
AI_TIMEOUT_MS=15000
